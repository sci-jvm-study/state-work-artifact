# ---- kya chalana hai ----
target    = BranchTree
classpath = bin
sourcepath = .

# ---- kya symbolic banana hai ----
symbolic.method = BranchTree.classify(sym#sym#sym)

# ---- symbolic int ki range ----
symbolic.min_int = -100
