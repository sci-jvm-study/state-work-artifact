@@ -140,7 +140,15 @@ public class SymbolicConstraintsGeneral {
                 }
             }
 
+            // W_solver instrumentation --
+            // this is THE single dispatch point every decision-procedure backend
+            // goes through (see the dp-selection switch above), so counting/timing
+            // exactly here captures every real solver invocation regardless of
+            // which backend (z3, choco, ...) is configured.
+            long __solverStart = System.nanoTime();
             result = pb.solve();
+            SolverStats.cumulativeSolveNanos += (System.nanoTime() - __solverStart);
+            SolverStats.invocationCount++;
         }
 
