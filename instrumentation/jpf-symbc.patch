diff --git a/jpf.properties b/jpf.properties
index dd93853..62b8544 100644
--- a/jpf.properties
+++ b/jpf.properties
@@ -40,6 +40,12 @@ jpf-symbc.Windows.amd64.native_libraries=\
   ${jpf-symbc}/lib/libz3java.dll;\
   ${jpf-symbc}/lib/libz3.dll;
 
